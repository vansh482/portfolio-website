---
interface Props {
  lastPushRepo?: string;
  lastPushTime?: string;
  commitsThisMonth?: number;
  activeRepos?: number;
}

const {
  lastPushRepo = 'portfolio-website',
  lastPushTime = 'just now',
  commitsThisMonth = 0,
  activeRepos = 0,
} = Astro.props;
---

<div class="status-bar">
  <span class="status-dot"></span>
  <span class="status-label">shipping</span>
  <span class="status-sep">&middot;</span>
  <span>last push <span class="status-amber">{lastPushTime}</span> to <span class="status-cyan">{lastPushRepo}</span></span>
  {commitsThisMonth > 0 && (
    <>
      <span class="status-sep">&middot;</span>
      <span><span class="status-amber">{commitsThisMonth}</span> commits this month</span>
    </>
  )}
  {activeRepos > 0 && (
    <>
      <span class="status-sep">&middot;</span>
      <span><span class="status-amber">{activeRepos}</span> repos active</span>
    </>
  )}
</div>

<style>
  .status-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px clamp(20px, 5vw, 60px);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    white-space: nowrap;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(70, 224, 139, 0.5);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .status-label {
    color: var(--text);
    font-weight: 700;
  }

  .status-sep {
    color: var(--line2);
  }

  .status-cyan {
    color: var(--cyan);
  }

  .status-amber {
    color: var(--amber);
  }

  @media (max-width: 640px) {
    .status-bar {
      font-size: 11px;
      gap: 8px;
      padding: 6px 16px;
    }
  }
</style>
