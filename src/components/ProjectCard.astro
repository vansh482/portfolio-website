---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stackItems = project.language
  ? [project.language, ...Object.keys(project.languages).filter(l => l !== project.language).slice(0, 3)]
  : Object.keys(project.languages).slice(0, 4);
---

<a class="card" href={`${base}/projects/${project.slug}`}>
  <span class="card-arrow">&nearr;</span>
  <div class="card-org">
    {project.org ? `${project.org} · ` : ''}{project.year}
  </div>
  <div class="card-name">{project.displayName}</div>
  <div class="card-desc">{project.description}</div>
  {stackItems.length > 0 && (
    <div class="card-stack">
      {stackItems.map(s => <span>{s}</span>)}
    </div>
  )}
  {project.metrics && project.metrics.length > 0 && (
    <div class="card-metrics">
      {project.metrics.map(m => (
        <div class="metric">
          <div class="metric-val">{m.value}</div>
          <div class="metric-lbl">{m.label}</div>
        </div>
      ))}
    </div>
  )}
</a>

<style>
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 28px;
    position: relative;
    overflow: hidden;
    display: block;
    transition: border-color 0.3s, transform 0.3s;
  }

  .card:hover {
    border-color: var(--line2);
    transform: translateY(-2px);
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan), var(--blue));
    opacity: 0;
    transition: opacity 0.3s;
  }

  .card:hover::before { opacity: 1; }

  .card-arrow {
    position: absolute;
    top: 28px; right: 28px;
    font-size: 18px;
    color: var(--dimmer);
    transition: color 0.3s, transform 0.3s;
  }

  .card:hover .card-arrow {
    color: var(--cyan);
    transform: translate(3px, -3px);
  }

  .card-org {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--dimmer);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .card-name {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
    padding-right: 30px;
  }

  .card-desc {
    font-size: 14px;
    color: #9fb0ce;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .card-stack span {
    font-family: var(--mono);
    font-size: 11px;
    padding: 4px 10px;
    border: 1px solid var(--line2);
    border-radius: 20px;
    color: #9fb0ce;
  }

  .card-metrics {
    display: flex;
    gap: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .metric-val {
    font-weight: 700;
    font-size: 18px;
    background: linear-gradient(100deg, var(--cyan), var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .metric-lbl {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--dimmer);
    text-transform: uppercase;
    margin-top: 2px;
  }
</style>
