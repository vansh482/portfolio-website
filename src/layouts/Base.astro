---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import StatusBar from '../components/StatusBar.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import { getStats } from '../lib/transform';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Vansh Gupta — backend & distributed-systems engineer.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

let stats;
try {
  stats = await getStats();
} catch {
  stats = { lastPushRepo: 'unknown', lastPushTime: 'recently', commitsThisMonth: 0, activeReposThisMonth: 0 };
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`${Astro.site}portfolio-website/og-image.jpg`} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <ClientRouter />
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
    document.addEventListener('astro:before-swap', function(e) {
      var t = localStorage.getItem('theme') || 'dark';
      e.newDocument.documentElement.setAttribute('data-theme', t);
    });
    document.addEventListener('astro:after-swap', function() {
      var t = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    });
  </script>
</head>
<body>
  <Nav />
  <StatusBar
    lastPushRepo={stats.lastPushRepo}
    lastPushTime={stats.lastPushTime}
    commitsThisMonth={stats.commitsThisMonth}
    activeRepos={stats.activeReposThisMonth}
  />
  <main>
    <slot />
  </main>
  <Footer />
  <CustomCursor />
</body>
</html>
