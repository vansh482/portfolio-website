---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const experience = [
  { period: '2025 — present', role: 'SDE', org: 'Smartsheet', desc: 'Connectors, MCP tooling, enterprise data sync' },
  { period: '2024', role: 'SDE', org: 'Futures First', desc: 'Trading infrastructure, C++, low-latency event-driven systems' },
  { period: '2020 — 2024', role: 'B.Tech CSE', org: 'The LNMIIT', desc: 'JEE Advanced AIR 9684' },
];

const stackCols = [
  {
    title: 'Languages',
    items: [
      { name: 'Java', icon: 'java/java-original' },
      { name: 'C++', icon: 'cplusplus/cplusplus-original' },
      { name: 'Python', icon: 'python/python-original' },
      { name: 'SQL', icon: 'azuresqldatabase/azuresqldatabase-original' },
    ],
  },
  {
    title: 'Backend / Streaming',
    items: [
      { name: 'Spring Boot', icon: 'spring/spring-original' },
      { name: 'gRPC', icon: 'grpc/grpc-original' },
      { name: 'Kafka', icon: 'apachekafka/apachekafka-original' },
      { name: 'RocksDB', icon: 'rocksdb/rocksdb-plain' },
    ],
  },
  {
    title: 'Cloud / DevOps',
    items: [
      { name: 'AWS', icon: 'amazonwebservices/amazonwebservices-plain-wordmark' },
      { name: 'Docker', icon: 'docker/docker-original' },
      { name: 'Kubernetes', icon: 'kubernetes/kubernetes-plain' },
      { name: 'Terraform', icon: 'terraform/terraform-original' },
    ],
  },
  {
    title: 'Data / Observability',
    items: [
      { name: 'MySQL', icon: 'mysql/mysql-original' },
      { name: 'PostgreSQL', icon: 'postgresql/postgresql-original' },
      { name: 'MongoDB', icon: 'mongodb/mongodb-original' },
      { name: 'Datadog', icon: 'datadog/datadog-original' },
    ],
  },
];

const caps = ['Distributed Systems', 'Low-Latency', 'Fault Tolerance', 'Observability', 'Event-Driven', 'Replication'];
---

<Base title="About — Vansh Gupta">
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">About</div>
      <h1 class="page-title">
        Backend engineer who likes systems that <em>stay up when things go wrong.</em>
      </h1>

      <div class="bio">
        <p>I build resilient, fault-tolerant services at Smartsheet — high-throughput microservices and SaaS connectors moving enterprise data at scale.</p>
        <p>Before cloud SaaS, I wrote low-latency trading infrastructure in modern C++ at Futures First, where surviving partial failure and shaving microseconds <em>was</em> the job. That bias toward correctness under load follows me everywhere.</p>
      </div>

      <div class="caps">
        {caps.map((c) => <span class="cap">{c}</span>)}
      </div>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="wrap">
      <div class="eyebrow">Experience</div>
      <div class="timeline">
        {experience.map((exp, i) => (
          <div class="tl-entry">
            <div class="tl-dot-col">
              <span class={`tl-dot ${i === 0 ? 'active' : ''}`}></span>
              {i < experience.length - 1 && <span class="tl-line"></span>}
            </div>
            <div class="tl-content">
              <div class="tl-period">{exp.period}</div>
              <div class="tl-role">{exp.org} <span class="tl-sep">/</span> {exp.role}</div>
              <div class="tl-desc">{exp.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Stack</div>
      <div class="stack-grid">
        {stackCols.map((col) => (
          <div class="stack-col">
            <div class="stack-col-title">{col.title}</div>
            {col.items.map((item) => (
              <div class="tech-item">
                <img
                  src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${item.icon}.svg`}
                  alt={item.name}
                  width="22"
                  height="22"
                  loading="lazy"
                />
                <span>{item.name}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section stats-section">
    <div class="wrap">
      <div class="eyebrow">Numbers</div>
      <div class="stats-grid">
        <div class="stat">
          <div class="stat-val gradient-text">1600+</div>
          <div class="stat-label">Codeforces Rating &middot; Expert</div>
        </div>
        <div class="stat">
          <div class="stat-val gradient-text">#850</div>
          <div class="stat-label">Global Rank &middot; Round 896</div>
        </div>
        <div class="stat">
          <div class="stat-val gradient-text">5M+</div>
          <div class="stat-label">Records Load-Tested</div>
        </div>
        <div class="stat">
          <div class="stat-val gradient-text">2</div>
          <div class="stat-label">Production Connectors</div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 28px;
  }

  .page-title em {
    font-style: normal;
    background: linear-gradient(100deg, var(--cyan), var(--indigo));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bio {
    max-width: 640px;
  }

  .bio p {
    font-size: clamp(15px, 1.4vw, 18px);
    color: #aebcd6;
    line-height: 1.65;
  }

  .bio p + p {
    margin-top: 16px;
  }

  .bio em {
    font-style: italic;
    color: #cfe;
  }

  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .cap {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #bcd;
    padding: 8px 14px;
    border: 1px solid var(--line2);
    border-radius: 40px;
    background: var(--panel);
  }

  /* Timeline */
  .timeline-section {
    padding-top: 0;
  }

  .timeline {
    margin-top: 24px;
  }

  .tl-entry {
    display: flex;
    gap: 20px;
  }

  .tl-dot-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 20px;
    flex-shrink: 0;
  }

  .tl-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--line2);
    background: var(--ink);
    flex-shrink: 0;
    margin-top: 4px;
  }

  .tl-dot.active {
    border-color: var(--cyan);
    background: var(--cyan);
    box-shadow: 0 0 8px rgba(52, 231, 231, 0.4);
  }

  .tl-line {
    width: 2px;
    flex: 1;
    background: var(--line);
    min-height: 40px;
  }

  .tl-content {
    padding-bottom: 32px;
  }

  .tl-period {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--dimmer);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .tl-role {
    font-size: 18px;
    font-weight: 600;
  }

  .tl-sep {
    color: var(--dimmer);
    margin: 0 4px;
  }

  .tl-desc {
    font-size: 14px;
    color: var(--dim);
    margin-top: 4px;
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    margin-top: 20px;
  }

  .stack-col {
    background: var(--panel);
    padding: 24px 20px;
  }

  .stack-col-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--cyan);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
    color: #bcd0ec;
    padding: 8px 0;
  }

  .tech-item img {
    filter: drop-shadow(0 0 4px rgba(52, 231, 231, 0.2));
  }

  /* Stats */
  .stats-section {
    padding-top: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    margin-top: 20px;
  }

  .stat {
    background: var(--panel);
    padding: 28px 24px;
  }

  .stat-val {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--dim);
    margin-top: 10px;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .stack-grid,
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
